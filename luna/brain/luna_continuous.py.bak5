"""
Luna · Continuous (Always-On com Escuta Inteligente)
====================================================
Sem wake word. A Luna escuta sempre, mas só responde quando és tu (ou a Linda)
a chamá-la pelo nome em conversa natural.

Sub-fase: 1v.5 + streaming TTS (B2) + supervisor (B3) + fallback offline (B4).
Se o Ollama estiver em baixo, a Luna não fica muda: responde com presença.
"""

from __future__ import annotations

import os
import sys
import time
import traceback
from pathlib import Path

os.environ.setdefault("OLLAMA_KEEP_ALIVE", "2h")

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

import httpx  # noqa: E402  (dependência do cliente ollama)
from ollama import chat  # noqa: E402
from rich.console import Console
from rich.panel import Panel

from luna.audio.listener import LunaListener, ListenerEvent  # noqa: E402
from luna.audio.sentence_stream import SentenceStreamer  # noqa: E402
from luna.audio.stt import LunaSTT  # noqa: E402
from luna.audio.tts import LunaTTS  # noqa: E402
from luna.brain.luna_chat import (  # noqa: E402
    GENERATION_OPTIONS,
    MODEL,
    build_system_prompt,
    load_family,
)
from luna.core.fallback import resposta_offline  # noqa: E402
from luna.core.supervisor import log, protegido  # noqa: E402

console = Console()

FALLBACK_LLM = "Tive um problema a pensar. Podes repetir?"

# Excepções que significam "o Ollama está inalcançável"
ERROS_LIGACAO = (httpx.ConnectError, httpx.ConnectTimeout, ConnectionError)


def build_panel(model: str, owner_name: str) -> Panel:
    return Panel.fit(
        f"[bold cyan]Luna · Escuta Contínua[/bold cyan]\n"
        f"[dim]LLM: {model} · streaming TTS · supervisor · fallback offline[/dim]\n"
        f"[dim]Olá, {owner_name}. Diz 'Luna' em conversa para me chamares. "
        f"Ctrl+C para terminar.[/dim]",
        border_style="cyan",
    )


def main() -> None:
    family = load_family()
    owner_name = family["owner"]["name"]
    system_prompt = build_system_prompt(family)

    console.print(build_panel(MODEL, owner_name))

    # Carregar componentes (a ordem importa)
    stt = LunaSTT()  # carregada uma só vez, partilhada com listener
    tts = LunaTTS()
    listener = LunaListener(stt=stt)

    # Saudação inicial discreta (protegida: se o TTS falhar, fica no log)
    greeting = f"Estou aqui, {owner_name}."
    console.print(f"\n[bold magenta]Luna[/bold magenta] {greeting}")
    protegido("tts", tts.say, greeting)

    history = [{"role": "system", "content": system_prompt}]

    def responder(request: str) -> None:
        """LLM em streaming + TTS por frase. Falhas não saem daqui."""
        history.append({"role": "user", "content": request})

        streamer = SentenceStreamer(tts)
        streamer.start()

        console.print("\n[bold magenta]Luna[/bold magenta] ", end="")
        response_text = ""
        buffer = ""
        t0 = time.monotonic()
        t_primeira_frase: float | None = None
        falhou = False
        offline = False

        try:
            stream = chat(
                model=MODEL,
                messages=history,
                stream=True,
                think=False,
                options=GENERATION_OPTIONS,
            )
            for chunk in stream:
                piece = chunk["message"]["content"]
                response_text += piece
                buffer += piece
                console.print(piece, end="", style="white")

                buffer = streamer.feed(buffer)
                if t_primeira_frase is None and streamer.frases_enviadas > 0:
                    t_primeira_frase = time.monotonic() - t0

            console.print()
            history.append({"role": "assistant", "content": response_text})
        except ERROS_LIGACAO:
            offline = True
            log.warning("Ollama indisponível — resposta offline")
            console.print(
                "\n[bold yellow](Ollama em baixo — resposta offline)[/bold yellow]"
            )
        except Exception:  # noqa: BLE001
            falhou = True
            log.error("Falha em llm:\n%s", traceback.format_exc())
            console.print(
                "\n[bold red](falha no LLM — registada no log)[/bold red]"
            )
        finally:
            # Fala o que já saiu e espera a última frase acabar de soar
            protegido("tts", streamer.finish, buffer)

        if offline:
            # O cérebro está em baixo: presença em vez de silêncio
            history.pop()  # remove o pedido sem resposta do histórico
            frase = resposta_offline()
            console.print(f"[bold magenta]Luna[/bold magenta] {frase}")
            protegido("tts", tts.say, frase)
            return

        if falhou and streamer.frases_enviadas == 0:
            # O LLM caiu sem dizer nada: frase de recurso genérica
            history.pop()
            console.print(f"[bold magenta]Luna[/bold magenta] {FALLBACK_LLM}")
            protegido("tts", tts.say, FALLBACK_LLM)
            return

        total = time.monotonic() - t0
        if t_primeira_frase is not None:
            console.print(
                f"[dim]  1ª frase no TTS   {t_primeira_frase:6.2f}s\n"
                f"  resposta completa {total:6.2f}s[/dim]"
            )

    def on_mention(event: ListenerEvent) -> None:
        """Callback da escuta. Blindado: nenhuma excepção sobe daqui."""
        try:
            request = event.request.strip()
            console.print(
                f"\n[dim italic]> {event.full_transcription}[/dim italic]"
            )

            if not request:
                ack = f"Sim, {owner_name}?"
                console.print(f"[bold magenta]Luna[/bold magenta] {ack}")
                protegido("tts", tts.say, ack)
                return

            responder(request)
        except Exception:  # noqa: BLE001
            log.error("Falha não classificada em on_mention:\n%s",
                      traceback.format_exc())

    # Loop exterior: se o próprio listener cair (ex.: microfone desligado),
    # regista, espera 2s e tenta de novo. Só o Ctrl+C termina a Luna.
    while True:
        try:
            listener.listen(on_mention)
            break  # listener terminou de forma limpa (stop())
        except KeyboardInterrupt:
            console.print(f"\n[dim]A terminar. Até logo, {owner_name}.[/dim]")
            protegido("tts", tts.say, f"Até logo, {owner_name}.")
            break
        except Exception:  # noqa: BLE001
            log.error("Falha no listener:\n%s", traceback.format_exc())
            console.print(
                "[bold red](falha no listener — registada; a tentar de novo "
                "em 2s)[/bold red]"
            )
            time.sleep(2)


if __name__ == "__main__":
    main()
